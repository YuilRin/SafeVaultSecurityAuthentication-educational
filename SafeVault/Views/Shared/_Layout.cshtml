<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SafeVault</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <nav>
        <a asp-controller="Home" asp-action="Index">SafeVault</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Profile" asp-action="Index">Profile</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index">Admin</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                <button type="submit">Log out</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Log in</a>
            <a asp-controller="Account" asp-action="Register">Register</a>
        }
    </nav>
</header>
<main>
    @RenderBody()
</main>
</body>
</html>
